PORT=5000
JWT_SECRET=your_jwt_secret_here
DATABASE_FILE=:memory:

# Email Service Configuration
EMAIL_SERVICE=ethereal
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_password_here
EMAIL_FROM="Uclose Orders" <your_email_user_here>

# Database Configuration
MONGODB_URI=your_mongodb_connection_string

# SendGrid Configuration (Set this key to use SendGrid instead of standard SMTP)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# EMAIL_FROM="Uclose" <your_verified_sendgrid_sender_email_here>

# Stripe Configuration (Set this key to use Stripe instead of simulated mock checkout)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Google Authentication
# GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

